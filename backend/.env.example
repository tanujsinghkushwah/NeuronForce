# ==============================================================================
# NeuronForce Backend Configuration
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Environment mode: development | staging | production
ENVIRONMENT=development
DEBUG=true

# Database Configuration
# SQLite default for local development:
DATABASE_URL=sqlite:///./neuronforce.db
# PostgreSQL for production deployment:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neuronforce

# Security & JWT Authentication
# IMPORTANT: Generate a strong random key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=neuronforce-enterprise-jwt-secret-key-prod-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth 2.0 / SSO Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Network URLs & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Optional Firebase Project Settings
FIREBASE_PROJECT_ID=

# AI Inference - OpenRouter
# Get your API key at https://openrouter.ai/keys
# Change OPENROUTER_MODEL to any supported model (e.g. meta-llama/llama-3.3-70b-instruct,
# anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001, openai/gpt-4o-mini)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Outbound Email Dispatch (Free Demo Service)
# Resend provides 3,000 free emails/month with a single API key: https://resend.com
RESEND_API_KEY=

